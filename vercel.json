{
  "functions": {
    "api/desk.js": {
      "includeFiles": "desk.html"
    },
    "api/*.js": {
      "includeFiles": "{desk.html,lib/**}"
    }
  },
  "rewrites": [
    { "source": "/public/:path*", "destination": "/:path*" },
    { "source": "/desk/login", "destination": "/login.html" },
    { "source": "/desk", "destination": "/api/desk" },
    { "source": "/staff", "destination": "/api/desk" }
  ]
}
